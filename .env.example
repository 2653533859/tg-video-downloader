# 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ==================== Telegram API ====================
# 必需：从 https://my.telegram.org 获取
TG_API_ID=12345
TG_API_HASH=your_api_hash_here

# ==================== Web 认证 ====================
# 必需：Web UI 登录凭据（混合鉴权：HTTP Basic Auth 与网页登录页共用同一组凭据）
WEB_AUTH_USERNAME=admin
WEB_AUTH_PASSWORD=your_secure_password

# ==================== Web 会话（网页登录） ====================
# WEB_SESSION_SECRET：Flask 会话签名密钥；留空则由 WEB_AUTH_* 经 sha256 派生（重启后旧会话不失效）。
#   多实例部署或需要稳定密钥时，显式设置一个随机串。
WEB_SESSION_SECRET=
# 会话 cookie 的 Secure 标志；留空按 PUBLIC_BASE_URL 是否 https 自动推断，HTTPS 部署建议设 true。
WEB_SESSION_COOKIE_SECURE=

# ==================== 代理配置 ====================
# 可选：如果需要代理访问 Telegram（当前仅支持 http 类型）
TG_PROXY_ENABLED=false
TG_PROXY_TYPE=http
TG_PROXY_HOST=127.0.0.1
TG_PROXY_PORT=7890

# ==================== Relay 配置（在线播放） ====================
# PUBLIC_BASE_URL 用于生成外部播放器可访问的签名 URL
PUBLIC_BASE_URL=http://localhost:5003
RELAY_TOKEN_SECRET=change_this_to_random_string
RELAY_TOKEN_TTL=1800

# ==================== tdl 配置 ====================
# 可选：tdl 直连下载
TDL_BINARY=/usr/local/bin/tdl
TDL_NAMESPACE=default
TDL_STORAGE_PATH=/root/.tdl/data
TDL_THREADS=8
TDL_LIMIT=4

# ==================== 功能开关 ====================
DEBUG_API_ENABLED=false
OPEN_FOLDER_ENABLED=false
# 仅当部署在可信反向代理之后时才设为 true（否则 X-Forwarded-For 可被伪造绕过认证）
TRUST_FORWARDED_FOR=false

# ==================== Google Drive / rclone 配置 ====================
# 是否启用 Google Drive 保存功能（需要安装并配置 rclone）
GDRIVE_ENABLED=false
# rclone 二进制路径（默认系统 PATH）
GDRIVE_RCLONE_BINARY=rclone
# rclone 配置文件路径（留空则使用系统默认 ~/.config/rclone/rclone.conf）
GDRIVE_RCLONE_CONFIG=
# rclone 配置中的 remote 名称（例如 gdrive 或 gdrive:）
GDRIVE_RCLONE_REMOTE=gdrive
# Google Drive 保存的目标文件夹名
GDRIVE_TARGET_DIR=TG_Downloads
# 下载完成后是否自动触发上传到 Google Drive
GDRIVE_AUTO_UPLOAD=false
# 上传成功后是否自动删除本地文件（节省 VPS 本地硬盘空间）
GDRIVE_DELETE_LOCAL_AFTER_UPLOAD=false
# 上传最大并发数（建议 1）
GDRIVE_MAX_CONCURRENT_UPLOADS=1
# 上传带宽限制（例如 10M，留空不限制）
GDRIVE_BWLIMIT=
